[Unit]
Description=aryadubey.tech (Next.js + Payload)
After=network.target postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/aryadubey-releases/current
EnvironmentFile=/var/www/aryadubey-shared/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
